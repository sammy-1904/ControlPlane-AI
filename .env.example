# ControlPlane.ai Configuration

# Model Provider: MOCK (default) | GROQ | GEMINI | OPENAI
ACTIVE_PROVIDER=MOCK

# Enable Real ML Models (DeBERTa-v3 SLM, Microsoft Presidio, ChromaDB, NLI Cross-Encoder)
USE_REAL_ML_MODELS=true

# API Keys (optional if using MOCK)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
