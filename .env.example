# ControlPlane.ai Environment Variables
# Leave keys blank to use the built-in Deterministic Mock Provider

# Groq API Key (Free tier from https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API Key (Free tier from https://aistudio.google.com)
GEMINI_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8080

# Default Provider fallback (mock, groq, gemini)
DEFAULT_PROVIDER=mock

# Audit Database Path
DATABASE_URL=sqlite:///./data/audit.db
